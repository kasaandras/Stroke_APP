# Copy to .env.local (gitignored) for local development.
#
# When BACKEND_URL is set, next.config.ts proxies /api/* to this URL
# (so /api/predict in the browser hits a locally-running uvicorn). On
# Vercel this env var is left unset, so Next.js does NOT rewrite and
# /api/predict is served by the Python serverless function directly.
BACKEND_URL=http://127.0.0.1:8000
